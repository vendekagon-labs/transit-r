#!/usr/bin/env Rscript
# Reads each transit value from stdin as it arrives and writes it back to
# stdout. Needs the package installed (e.g. with R_LIBS pointing at it).
#
# usage: read-write [json|json-verbose|msgpack]

library(transit)
args <- commandArgs(trailingOnly = TRUE)
format <- if (length(args) > 0) args[1] else "json"
input <- file("stdin", "rb")
output <- file("/dev/stdout", "wb", raw = TRUE)
read_transit_stream(input, function(value) write_transit(value, output, format), format)
